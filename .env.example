# Exemple de configuration — copier vers .env (app) et/ou .env2 (serveur Waitress)
# Ne jamais committer les fichiers .env / .env2 réels.

# --- Clé de session Flask ---
# Si vide, une clé aléatoire est générée dans instance/secret_key
SECRET_KEY=

# --- Base de données ---
# Par défaut : SQLite dans instance/validation.db
DATABASE_URL=

# --- Compte super administrateur (créé au premier lancement) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Super Administrateur

# --- Sécurité cookies (1 = HTTPS obligatoire) ---
COOKIE_SECURE=1

# --- Envoi d'emails (réinitialisation de mot de passe) ---
# Laisser MAIL_SERVER vide désactive l'envoi (le lien s'affiche à l'écran)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_TIMEOUT=15

# --- Serveur de production (server.py / .env2) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=12001
THREADS=16
